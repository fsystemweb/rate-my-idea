{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["MONGODB_URI", "DEV"]
    },
    "client#build": {
      "outputs": ["../../dist/client/**"]
    },
    "api#build": {
      "outputs": ["../../dist/api/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}